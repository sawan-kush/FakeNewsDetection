# Copy to backend/.env and fill in. Never commit .env.


# Groq API (https://console.groq.com/) - required for claim extraction and evidence verification
GROQ_API_KEY=
# Any chat model your Groq account supports. Check https://console.groq.com/docs/models for current names.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=openai/gpt-oss-120b

TAVILY_API_KEY=
MAX_CLAIMS=3
MAX_PAGES_TO_FETCH=4
HTTP_TIMEOUT=5

# --- optional tuning ---
# MAX_CLAIMS=3
# RESULTS_PER_QUERY=6
# MAX_PAGES_TO_FETCH=6
# HTTP_TIMEOUT=8
# RESPECT_ROBOTS=true
# TRUTHLENS_ARTIFACT_DIR=artifacts
# TRUTHLENS_HISTORY_DB=data/history.sqlite3
# LOG_USER_TEXT=false
HOST=127.0.0.1
PORT=5000
